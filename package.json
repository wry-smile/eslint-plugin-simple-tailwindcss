{
  "name": "@wry-smile/eslint-plugin-simple-tailwindcss",
  "type": "module",
  "version": "0.2.2",
  "description": "ESLint plugin that keeps Tailwind CSS class usage consistent across Vue, JSX, and utility helpers.",
  "author": "@wry-smile",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wry-smile/eslint-plugin-simple-tailwindcss"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "tailwindcss",
    "sorting",
    "clsx",
    "cva"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsdown",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --declarationMap false",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "release": "pnpm build && bumpp && pnpm publish"
  },
  "peerDependencies": {
    "eslint": "^10.0.0 || ^9.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.60.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/parser": "^8.60.1",
    "bumpp": "^11.1.0",
    "eslint": "^10.4.1",
    "eslint-plugin-format": "^2.0.1",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.1"
  }
}
